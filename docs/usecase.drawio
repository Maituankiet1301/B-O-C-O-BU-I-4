        <!-- Bảng chú thích (Legend) -->
        <mxCell id="legend_box" value="CHÚ THÍCH KÝ HIỆU (LEGEND)&#xa;─────────────────────────────────────&#xa;• Hình chữ nhật nét đậm: Ranh giới hệ thống (System Boundary)&#xa;• Người que: Tác nhân ngoài (Actor: Người dùng hoặc Bộ lập lịch Cron)&#xa;• Hình oval: Use Case nghiệp vụ (Chức năng hệ thống cung cấp)&#xa;• «include»: Bắt buộc thực hiện UC liên kết (UC2 luôn thực thi sau UC1)&#xa;• «extend»: Mở rộng có điều kiện (chỉ thực hiện khi có dữ liệu lỗi)&#xa;• Đoạn nối liền: Liên kết tham gia tương tác giữa Actor và Use Case" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#fffbeb;strokeColor=#b45309;strokeWidth=1;size=14;align=left;spacingLeft=8;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="50" y="470" width="310" height="150" as="geometry" />
        </mxCell>

        <!-- Dòng Ngoài phạm vi (Out of Scope) -->
        <mxCell id="scope_box" value="⚠️ NGOÀI PHẠM VI HỆ THỐNG (OUT OF SCOPE):&#xa;1. Hệ thống POS quầy thu ngân tại từng cửa hàng (chỉ nhận file kết xuất).&#xa;2. Cổng thanh toán trực tuyến &amp; Ngân hàng.&#xa;3. Hệ thống quản lý kiểm kê tồn kho vật lý." style="shape=rect;rounded=1;arcSize=6;fillColor=#fef2f2;strokeColor=#ef4444;strokeWidth=1.5;align=left;spacingLeft=8;fontSize=11;fontColor=#991b1b;fontStyle=0;" vertex="1" parent="1">
