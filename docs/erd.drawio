<mxfile host="app.diagrams.net" modified="2026-10-21T09:20:00.000Z" agent="Copilot" version="24.7.17" type="device">
  <diagram id="data-model-l6" name="Star Schema — track DA">
    <mxGraphModel dx="1500" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="MEKONG MOBILE — STAR SCHEMA | GRAIN: 1 DÒNG / 1 SẢN PHẨM / 1 ĐƠN / 1 CỬA HÀNG / 1 NGÀY" style="text;html=1;align=center;verticalAlign=middle;fontSize=18;fontStyle=1;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="120" y="20" width="1260" height="45" as="geometry" /></mxCell>

        <mxCell id="date" value="dim_date&#xa;DIMENSION — thời gian&#xa;PK date_key INTEGER — YYYYMMDD surrogate date key&#xa;full_date DATE — ngày lịch đầy đủ&#xa;day_of_month SMALLINT — ngày trong tháng&#xa;month_number SMALLINT — số tháng 1–12&#xa;month_name VARCHAR(20) — tên tháng&#xa;quarter_number SMALLINT — quý 1–4&#xa;year_number SMALLINT — năm dương lịch" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#2563eb;strokeWidth=2;fontSize=12;align=left;verticalAlign=middle;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="25" y="100" width="390" height="220" as="geometry" /></mxCell>
        <mxCell id="store" value="dim_store&#xa;DIMENSION — chi nhánh&#xa;PK store_key BIGINT — khóa thay thế&#xa;UK store_id INTEGER — mã cửa hàng nghiệp vụ&#xa;store_code VARCHAR(10) — mã hiển thị, ví dụ CH01&#xa;store_name VARCHAR(100) — tên cửa hàng từ danh mục&#xa;&#xa;Quy tắc: mã cửa hàng phải có trong stores.csv." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#2563eb;strokeWidth=2;fontSize=12;align=left;verticalAlign=middle;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="25" y="455" width="390" height="205" as="geometry" /></mxCell>
        <mxCell id="product" value="dim_product&#xa;DIMENSION — sản phẩm&#xa;PK product_key BIGINT — khóa thay thế; -1 = chưa rõ&#xa;product_id VARCHAR(50) — mã/tên nguồn chuẩn hóa&#xa;product_name VARCHAR(200) — tên hiển thị chuẩn&#xa;normalized_name VARCHAR(200) — tên đã chuẩn hóa&#xa;category_name VARCHAR(100) — nhóm danh mục&#xa;&#xa;Mã không khớp danh mục ánh xạ product_key = -1." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#2563eb;strokeWidth=2;fontSize=12;align=left;verticalAlign=middle;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="1085" y="100" width="390" height="220" as="geometry" /></mxCell>
        <mxCell id="customer" value="dim_customer&#xa;DIMENSION — khách hàng&#xa;PK customer_key BIGINT — khóa thay thế; 0 = khách vãng lai&#xa;normalized_phone VARCHAR(15) — SĐT chuẩn hóa; dữ liệu nhạy cảm&#xa;phone_masked VARCHAR(15) — SĐT che 4 số cuối cho UI&#xa;is_valid_phone BOOLEAN — SĐT đạt chuẩn 10 số&#xa;&#xa;Không hiển thị normalized_phone trên dashboard." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#2563eb;strokeWidth=2;fontSize=12;align=left;verticalAlign=middle;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="1085" y="455" width="390" height="205" as="geometry" /></mxCell>
        <mxCell id="fact" value="fact_sales&#xa;FACT — một dòng chi tiết sản phẩm trong đơn&#xa;PK sales_fact_key BIGINT — khóa thay thế dòng Fact&#xa;FK date_key INTEGER — ngày bán&#xa;FK store_key BIGINT — cửa hàng&#xa;FK product_key BIGINT — sản phẩm&#xa;FK customer_key BIGINT — khách hàng&#xa;order_id VARCHAR(50) — mã đơn tại cửa hàng&#xa;order_line_number INTEGER — số dòng ổn định trong đơn&#xa;quantity INTEGER — số lượng sản phẩm, > 0&#xa;unit_price BIGINT — đơn giá VNĐ&#xa;line_total BIGINT — thành tiền dòng VNĐ&#xa;discount_amount BIGINT — giảm giá được nguồn xác nhận&#xa;source_file VARCHAR(255) — tệp nguồn để đối soát&#xa;source_row_number BIGINT — số dòng nguồn&#xa;&#xa;Unique: (store_key, order_id, order_line_number)&#xa;Chỉ nạp khi DQ đạt; không lặp tổng tiền cấp đơn." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#15803d;strokeWidth=3;fontSize=12;align=left;verticalAlign=middle;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="535" y="185" width="510" height="500" as="geometry" /></mxCell>

        <mxCell id="rel_date" value="1 : N" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;startArrow=ERone;startFill=0;endArrow=ERmany;endFill=0;strokeColor=#475569;strokeWidth=2;fontSize=11;" edge="1" parent="1" source="date" target="fact"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="rel_store" value="1 : N" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;startArrow=ERone;startFill=0;endArrow=ERmany;endFill=0;strokeColor=#475569;strokeWidth=2;fontSize=11;" edge="1" parent="1" source="store" target="fact"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="rel_product" value="1 : N" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;startArrow=ERone;startFill=0;endArrow=ERmany;endFill=0;strokeColor=#475569;strokeWidth=2;fontSize=11;" edge="1" parent="1" source="product" target="fact"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="rel_customer" value="1 : N" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;startArrow=ERone;startFill=0;endArrow=ERmany;endFill=0;strokeColor=#475569;strokeWidth=2;fontSize=11;" edge="1" parent="1" source="customer" target="fact"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="note" value="Lưu ý tích hợp: order_items.csv cần được gắn store_id từ tệp/ngữ cảnh cửa hàng trước khi join orders theo (store_id, order_id). Không join chỉ bằng mã đơn vì có 137 mã trùng giữa cửa hàng. Các thuộc tính store/product phải được đối chiếu schema CSV thực tế trước BT2." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff7ed;strokeColor=#ea580c;strokeWidth=2;fontSize=12;align=left;verticalAlign=middle;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="440" y="735" width="720" height="95" as="geometry" /></mxCell>
        <mxCell id="legend" value="CHÚ THÍCH: PK = khóa chính • FK = khóa ngoại • UK = khóa nghiệp vụ duy nhất • 1:N = một dòng dimension có thể liên kết nhiều dòng fact • VNĐ là số nguyên." style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#334155;" vertex="1" parent="1"><mxGeometry x="250" y="840" width="1100" height="30" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
