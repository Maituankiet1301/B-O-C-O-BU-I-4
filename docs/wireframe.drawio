        <mxCell id="k2" value="SỐ ĐƠN&#xa;COUNT DISTINCT (store_key, order_id)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#64748b;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="435" y="185" width="330" height="90" as="geometry" /></mxCell>
