        <mxCell id="chart" value="BIỂU ĐỒ ĐƯỜNG — DOANH THU THEO NGÀY&#xa;(dim_date.full_date × SUM(fact_sales.line_total))&#xa;&#xa;Doanh thu ↑&#xa;│       ╱╲       ╱╲&#xa;│   ╱╲╱    ╲  ╱╲╱&#xa;└────────────────────→ Ngày" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="70" y="305" width="690" height="320" as="geometry" /></mxCell>
        <mxCell id="table" value="CHI TIẾT GIAO DỊCH&#xa;Mã đơn | Ngày | Sản phẩm | Thành tiền | SĐT đã che&#xa;order_id | full_date | product_name | line_total | phone_masked&#xa;────────────────────────────────────────────&#xa;[Không có dữ liệu: hiển thị trạng thái rỗng; KPI = 0]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#94a3b8;fontSize=12;align=left;verticalAlign=top;spacingLeft=12;spacingTop=12;" vertex="1" parent="1"><mxGeometry x="790" y="305" width="340" height="320" as="geometry" /></mxCell>
