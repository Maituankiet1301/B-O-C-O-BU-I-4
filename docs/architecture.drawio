<mxfile host="app.diagrams.net" modified="2026-10-21T09:20:00.000Z" agent="Copilot" version="24.7.17" type="device">
  <diagram id="architecture-l6" name="Kiến trúc và luồng dữ liệu L6">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="SMART CRM — MEKONG MOBILE | LUỒNG L6 — KIẾN TRÚC &amp; DATA FLOW" style="text;html=1;align=center;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="250" y="20" width="900" height="40" as="geometry" /></mxCell>

        <mxCell id="sources" value="NGUỒN DỮ LIỆU&#xa;24 tệp CSV/Excel cửa hàng&#xa;orders_2024_2026.csv&#xa;order_items.csv&#xa;products.csv • stores.csv&#xa;&#xa;Gắn store_id từ ngữ cảnh tệp" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#2563eb;strokeWidth=2;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="230" width="220" height="180" as="geometry" /></mxCell>
        <mxCell id="scheduler" value="Cron Scheduler&#xa;Kích hoạt pipeline 02:00" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#64748b;strokeWidth=2;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="45" y="100" width="190" height="70" as="geometry" /></mxCell>
        <mxCell id="engineer" value="Data Engineer&#xa;Vận hành • theo dõi Reject&#xa;đối soát và chạy lại" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e0f2fe;strokeColor=#0284c7;strokeWidth=2;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="45" y="500" width="190" height="90" as="geometry" /></mxCell>

        <mxCell id="ingest" value="1. NẠP &amp; STAGING&#xa;Đọc theo lô, giữ nguồn tệp/dòng&#xa;Không mất thông tin đối soát" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#2563eb;strokeWidth=2;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="300" y="225" width="205" height="125" as="geometry" /></mxCell>
        <mxCell id="quality" value="2. CHUẨN HÓA &amp; DATA QUALITY&#xa;Ngày • điện thoại • tiền tệ&#xa;Khóa cửa hàng + mã đơn&#xa;Kiểm tra danh mục và số tiền" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#d97706;strokeWidth=2;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="555" y="225" width="245" height="125" as="geometry" /></mxCell>
        <mxCell id="reject" value="REJECT + AUDIT LOG&#xa;Mã lỗi • nguồn • thời điểm&#xa;Đối soát và xử lý lại" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#dc2626;strokeWidth=2;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="565" y="430" width="225" height="95" as="geometry" /></mxCell>
        <mxCell id="load" value="3. NẠP KHO CHIỀU&#xa;Upsert dimension&#xa;Nạp Fact theo grain dòng hàng&#xa;Ràng buộc FK + chạy lại an toàn" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;strokeWidth=2;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="850" y="225" width="235" height="125" as="geometry" /></mxCell>
        <mxCell id="dwh" value="KHO DỮ LIỆU — DUCKDB&#xa;Star Schema&#xa;fact_sales&#xa;dim_date • dim_store&#xa;dim_product • dim_customer" style="shape=cylinder;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#ecfdf5;strokeColor=#15803d;strokeWidth=2;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1125" y="220" width="235" height="155" as="geometry" /></mxCell>
        <mxCell id="access" value="LỚP TRUY CẬP DỮ LIỆU&#xa;Truy vấn theo vai trò/chi nhánh&#xa;Chỉ trả phone_masked cho UI" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e8ff;strokeColor=#7e22ce;strokeWidth=2;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1120" y="445" width="245" height="105" as="geometry" /></mxCell>
        <mxCell id="dashboard" value="DASHBOARD STREAMLIT&#xa;UC4 • doanh thu cửa hàng&#xa;UC5 • danh mục theo quý&#xa;UC6 • so sánh/cảnh báo" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f3ff;strokeColor=#7e22ce;strokeWidth=2;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1120" y="620" width="245" height="110" as="geometry" /></mxCell>
        <mxCell id="users" value="NGƯỜI DÙNG&#xa;Quản lý cửa hàng: đúng 1 chi nhánh&#xa;Ban giám đốc: tổng hợp toàn chuỗi" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fefce8;strokeColor=#ca8a04;strokeWidth=2;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="825" y="620" width="250" height="110" as="geometry" /></mxCell>

        <mxCell id="flow1" value="tệp nguồn + metadata cửa hàng" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#2563eb;strokeWidth=2;fontSize=11;" edge="1" parent="1" source="sources" target="ingest"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="flow2" value="bản ghi thô" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#2563eb;strokeWidth=2;fontSize=11;" edge="1" parent="1" source="ingest" target="quality"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="flow3" value="hợp lệ" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#16a34a;strokeWidth=2;fontSize=11;" edge="1" parent="1" source="quality" target="load"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="flow4" value="không đạt → cách ly" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#dc2626;strokeWidth=2;fontSize=11;" edge="1" parent="1" source="quality" target="reject"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="flow5" value="Fact + Dimensions" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#16a34a;strokeWidth=2;fontSize=11;" edge="1" parent="1" source="load" target="dwh"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="flow6" value="SQL tổng hợp" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#7e22ce;strokeWidth=2;fontSize=11;" edge="1" parent="1" source="dwh" target="access"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="flow7" value="KPI / biểu đồ đã lọc và che SĐT" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#7e22ce;strokeWidth=2;fontSize=11;" edge="1" parent="1" source="access" target="dashboard"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="flow8" value="xem báo cáo" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#ca8a04;strokeWidth=2;fontSize=11;" edge="1" parent="1" source="users" target="dashboard"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="flow9" value="lịch chạy" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748b;strokeWidth=2;fontSize=11;" edge="1" parent="1" source="scheduler" target="ingest"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="flow10" value="theo dõi / chạy lại" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#0284c7;strokeWidth=2;fontSize=11;" edge="1" parent="1" source="engineer" target="reject"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="legend" value="CHÚ THÍCH: Mũi tên liền = luồng dữ liệu/điều khiển; xanh dương = nguồn/nạp; xanh lá = dữ liệu đạt chuẩn; đỏ = cách ly; tím = truy vấn/trình bày." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#94a3b8;fontSize=11;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="785" width="1330" height="45" as="geometry" /></mxCell>
        <mxCell id="outscope" value="NGOÀI PHẠM VI: POS/thanh toán tại quầy • quản lý tồn kho vật lý • gửi SMS/email • hạ tầng production nhiều nút." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff7ed;strokeColor=#ea580c;strokeWidth=2;dashed=1;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="300" y="500" width="460" height="80" as="geometry" /></mxCell>
